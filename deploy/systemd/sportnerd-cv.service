[Unit]
Description=SportNerdBot CV Worker Service
After=network.target

[Service]
Type=simple
User=sportnerd
Group=sportnerd
WorkingDirectory=/opt/sportnerdbot/current
EnvironmentFile=/etc/sportnerdbot/env
ExecStart=/opt/sportnerdbot/venv/bin/python -m cv_worker.worker
Restart=always
RestartSec=5
Nice=10
CPUWeight=50
MemoryMax=500M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sportnerdbot /opt/sportnerdbot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
