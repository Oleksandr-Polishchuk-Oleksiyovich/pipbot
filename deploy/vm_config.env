AUTODEPLOY_INTERVAL=1min
CV_CLAIM_WAIT_S=25
CV_RESULTS_INTERVAL_SEC=10
ADMIN_TASKS_ANNOUNCE_INTERVAL_SEC=60
# Режим довіри (TRUST_MODE) — М'ЯКИЙ РЕЖИМ «ДО ВИПРАВЛЕННЯ» (тимчасово, поки CV-лічильник ненадійний; замінити, коли CV покращиться):
# вірити заявленій кількості повторів у підписі/повідомленні й оспорюванню підрахунку (слова людини > CV). 0 — стара поведінка.
TRUST_MODE=1
# Підсумок дня / межа дня челенджу (Europe/Kyiv): відео до цього часу йдуть у попередній день
DAY_ROLLOVER_HOUR=2
DAY_ROLLOVER_MINUTE=30
# Пробудження box (Grok Bot) вебхуком, коли відео в черзі, а CV-воркер не поллить (core/wake.py). Без секрету — no-op.
# Секрет вебхука НЕ тут: кладеться на VM через tools/set_wake_webhook.py (POST /admin/secrets/wake).
WAKE_ENABLED=1
WAKE_STALE_S=45
WAKE_WAIT_S=90
